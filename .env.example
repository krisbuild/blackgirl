# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
# Server-side only. Never prefix with NEXT_PUBLIC_.
YOUCAM_API_KEY=

# "mock" returns clearly labelled demo data and spends no API units.
# Leave empty (or "live") to call the real API. Mock is also used automatically when no key is set.
YOUCAM_MODE=mock
