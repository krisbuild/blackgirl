# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
# Server-side only. Never prefix with NEXT_PUBLIC_.
YOUCAM_API_KEY=

# Supabase (Project Settings -> API). The publishable key is safe in the browser;
# data is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
